<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <RootNamespace>MSCCoop</RootNamespace>
    <AssemblyName>MSCCoop</AssemblyName>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MSCCoop.Net\MSCCoop.Net.csproj" Private="false" />
    <Reference Include="MSCLoader" HintPath="$(ManagedDir)\MSCLoader.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="ES2" HintPath="$(ManagedDir)\ES2.dll" Private="false" />
    <Reference Include="PlayMaker" HintPath="$(ManagedDir)\PlayMaker.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(ManagedDir)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="cInput" HintPath="$(ManagedDir)\cInput.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyToMods" AfterTargets="Build" Condition="Exists('$(GameDir)\Mods')">
    <MakeDir Directories="$(GameDir)\Mods\References" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\MSCCoop.Net\bin\$(Configuration)\net35\MSCCoop.Net.dll" DestinationFolder="$(GameDir)\Mods\References" />
  </Target>

</Project>
